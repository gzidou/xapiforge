{
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "printWidth": 999,
        "trailingComma": "none",
        "arrowParens": "avoid"
      }
    }
  ]
}
