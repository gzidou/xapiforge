{
  "name": "@xapiforge/adapter-browser",
  "version": "0.1.4",
  "private": false,
  "description": "Browser TokenStore adapters backed by localStorage, sessionStorage, or cookies",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzidou/xapiforge.git",
    "directory": "packages/adapter-browser"
  },
  "homepage": "https://gzidou.github.io/xapiforge/getting-started/browser",
  "bugs": {
    "url": "https://github.com/gzidou/xapiforge/issues"
  },
  "keywords": [
    "openapi",
    "browser",
    "token-storage",
    "localstorage",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm exec tsx ../../scripts/strip-js-comments.ts dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@xapiforge/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
