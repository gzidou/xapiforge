{
  "name": "@xapiforge/adapter-capacitor",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "Capacitor token storage and native file downloads for xapiforge",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzidou/xapiforge.git",
    "directory": "packages/adapter-capacitor"
  },
  "homepage": "https://gzidou.github.io/xapiforge/getting-started/ionic-capacitor",
  "bugs": {
    "url": "https://github.com/gzidou/xapiforge/issues"
  },
  "keywords": [
    "openapi",
    "capacitor",
    "ionic",
    "token-storage",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm exec tsx ../../scripts/strip-js-comments.ts dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@xapiforge/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
