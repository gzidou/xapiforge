{
  "name": "@xapiforge/vconsole-debug",
  "version": "0.2.0-alpha.0",
  "private": false,
  "description": "Framework-agnostic vConsole diagnostics with masked Storage snapshots and debug actions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzidou/xapiforge.git",
    "directory": "packages/vconsole-debug"
  },
  "homepage": "https://gzidou.github.io/xapiforge/guides/vconsole-debug",
  "bugs": {
    "url": "https://github.com/gzidou/xapiforge/issues"
  },
  "keywords": [
    "vconsole",
    "debugging",
    "diagnostics",
    "browser",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm exec tsx ../../scripts/strip-js-comments.ts dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
