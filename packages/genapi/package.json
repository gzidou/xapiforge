{
  "name": "@xapiforge/genapi",
  "version": "0.1.4",
  "private": false,
  "description": "OpenAPI-to-TypeScript client generator for xapiforge projects",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzidou/xapiforge.git",
    "directory": "packages/genapi"
  },
  "homepage": "https://github.com/gzidou/xapiforge#readme",
  "bugs": {
    "url": "https://github.com/gzidou/xapiforge/issues"
  },
  "keywords": [
    "openapi",
    "swagger",
    "typescript",
    "codegen",
    "cli"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "xapiforge": "./dist/cli.js",
    "xapiforge-fetch": "./dist/fetch-cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "openapi-fetch": "^0.17",
    "openapi-typescript": "^7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
