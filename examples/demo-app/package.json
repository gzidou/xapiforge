{
  "name": "@xapiforge/example-demo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "验证项目 — Vue 3 + @xapiforge/core + @xapiforge/genapi 全链路接入示例",
  "scripts": {
    "predev": "pnpm generate:api",
    "dev": "vite",
    "prebuild": "pnpm generate:api",
    "build": "vue-tsc --noEmit && vite build",
    "pretypecheck": "pnpm generate:api",
    "typecheck": "vue-tsc --noEmit",
    "predownload-swagger": "pnpm --filter '@xapiforge/genapi' build",
    "download-swagger": "xapiforge-fetch",
    "pregenerate:api": "pnpm --filter '@xapiforge/genapi' build",
    "generate:api": "xapiforge demo"
  },
  "dependencies": {
    "@xapiforge/core": "workspace:*",
    "@xapiforge/adapter-browser": "workspace:*"
  },
  "peerDependencies": {
    "vue": "*",
    "vue-router": "*"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@xapiforge/genapi": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
